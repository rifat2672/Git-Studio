{
  "name": "git-studio-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Git Studio REST + WebSocket API: git, GitHub, terminals and AI helpers",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx test/smoke.ts"
  },
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.18",
    "express": "^5.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0"
  }
}
